[Unit]
Description=Doesta Web API
After=network.target

[Service]
WorkingDirectory=/opt/doesta-backend
ExecStart=/opt/doesta-backend/Doesta.WebApi
Restart=always
# Restart service after 10 seconds if the dotnet service crashes:
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=doesta-webapi
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://*:5085

[Install]
WantedBy=multi-user.target
