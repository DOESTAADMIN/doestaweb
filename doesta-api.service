[Unit]
Description=Doesta Web API
After=network.target

[Service]
WorkingDirectory=/var/www/doesta-backend
ExecStart=/var/www/doesta-backend/Doesta.WebApi
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=doesta-api
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://localhost:5000

[Install]
WantedBy=multi-user.target
